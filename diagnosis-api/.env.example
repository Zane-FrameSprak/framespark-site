# FrameSpark Diagnosis API environment example
# Production note: use PORT=8788 because analytics-api already uses 8787.

HOST=127.0.0.1
PORT=8788

MAX_UPLOAD_MB=10
MIN_TEXT_CHARS=800
MAX_TEXT_CHARS=80000

# Required in production. Leave empty only for local mock mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=90000

# Keep V1 disabled by default unless explicitly approved.
ENABLE_DIAGNOSIS_V1=false
ENABLE_DEV_TOOLS=false

DIAGNOSIS_DAILY_LIMIT=
DIAGNOSIS_FEEDBACK_DAILY_LIMIT=
