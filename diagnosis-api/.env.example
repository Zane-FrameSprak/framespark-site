# FrameSpark Diagnosis API environment example
# Production note: use PORT=8788 because analytics-api already uses 8787.

NODE_ENV=development
HOST=127.0.0.1
PORT=8788

MAX_UPLOAD_MB=5
MAX_DOCX_EXPANDED_MB=20
MIN_TEXT_CHARS=80
MAX_INPUT_TOKENS=50000
REQUEST_TIMEOUT_MS=210000
DIAGNOSIS_DATA_DIR=/var/lib/framespark-diagnosis
DIAGNOSIS_METADATA_RETENTION_DAYS=30
DIAGNOSIS_REVIEW_RETENTION_DAYS=14

# Required in production. Leave empty only for local mock mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=90000

# Keep V1 disabled by default unless explicitly approved.
ENABLE_DIAGNOSIS_V1=false
ENABLE_V1_STAGED_RUNNER=false
ENABLE_V1_REAL_PROMPTS=false
ENABLE_DEV_TOOLS=false
FAIL_CLOSED_ON_V1_ERROR=false
REQUIRE_BETA_IDENTITY=false

TRUST_PROXY=loopback
ALLOWED_ORIGINS=https://framespark.cn
PROVIDER_CALL_LIMIT_PER_DIAGNOSIS=5
DIAGNOSIS_ACCOUNT_DAILY_LIMIT=3
DIAGNOSIS_IP_DAILY_LIMIT=6
DIAGNOSIS_GLOBAL_DAILY_LIMIT=20
PROVIDER_GLOBAL_DAILY_LIMIT=100
PROVIDER_GLOBAL_DAILY_TOKEN_LIMIT=5000000
DIAGNOSIS_CONCURRENCY_LIMIT=2
DIAGNOSIS_FEEDBACK_DAILY_LIMIT=10
