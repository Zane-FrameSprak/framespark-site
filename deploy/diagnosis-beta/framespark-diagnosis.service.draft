# DRAFT ONLY - review before copying to /etc/systemd/system/framespark-diagnosis.service
# This file is not installed by repository tooling and does not authorize deployment.

[Unit]
Description=FrameSpark Diagnosis API Invite Beta
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=framespark-diagnosis
Group=framespark-diagnosis
WorkingDirectory=/srv/framespark/diagnosis-api/current
EnvironmentFile=/etc/framespark/diagnosis-api.env
Environment=HOST=127.0.0.1
Environment=PORT=8788
ExecStart=/usr/bin/npm start
ExecStartPost=/usr/bin/curl --fail --retry 10 --retry-delay 1 http://127.0.0.1:8788/ready
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077

# Runtime hardening. The release tree is read-only; only the data directory is writable.
# Validate this exact set on the target host with systemd-analyze verify and a
# local readiness check. If one directive blocks Node from reading current,
# env, or data, remove only the confirmed incompatible directive and re-review;
# never drop all hardening merely to make the service start.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/framespark-diagnosis

# /var/lib/framespark-diagnosis must be a non-symlink directory owned by
# framespark-diagnosis:framespark-diagnosis with draft target mode 0700. It is
# outside webroot; consented full review records expire after at most 14 days.

# Journald must receive metadata and error codes only. The application must not log
# complete submitted material, complete reports, provider responses, or credentials.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=framespark-diagnosis

# /health and /ready are local checks only. Do not proxy either path through Nginx.

[Install]
WantedBy=multi-user.target
