# DRAFT PRODUCTION ENV TEMPLATE ONLY.
# Copy values through an approved secure process. Never commit the real env file.
# DEEPSEEK_API_KEY must remain a placeholder in this repository.

NODE_ENV=production
HOST=127.0.0.1
PORT=8788

DEEPSEEK_API_KEY=REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=90000
REQUEST_TIMEOUT_MS=210000

ENABLE_DIAGNOSIS_V1=true
ENABLE_V1_STAGED_RUNNER=true
ENABLE_V1_REAL_PROMPTS=true
ENABLE_DEV_TOOLS=false
FAIL_CLOSED_ON_V1_ERROR=true
REQUIRE_BETA_IDENTITY=true
ENABLE_BETA_CODE_ACCESS=false
ENABLE_PUBLIC_BETA_ACCESS=false

MAX_UPLOAD_MB=5
MAX_DOCX_EXPANDED_MB=20
MIN_TEXT_CHARS=80
MAX_INPUT_TOKENS=50000

PROVIDER_CALL_LIMIT_PER_DIAGNOSIS=5
DIAGNOSIS_ACCOUNT_DAILY_LIMIT=1
DIAGNOSIS_IP_DAILY_LIMIT=3
DIAGNOSIS_GLOBAL_DAILY_LIMIT=5
PROVIDER_GLOBAL_DAILY_LIMIT=30
DIAGNOSIS_CONCURRENCY_LIMIT=1
DIAGNOSIS_FEEDBACK_DAILY_LIMIT=10

DIAGNOSIS_DATA_DIR=/var/lib/framespark-diagnosis
DIAGNOSIS_METADATA_RETENTION_DAYS=30
DIAGNOSIS_REVIEW_RETENTION_DAYS=14

# Default diagnosis metadata excludes complete material and complete reports.
# Full material/report retention is permitted only after explicit review
# consent and is capped by DIAGNOSIS_REVIEW_RETENTION_DAYS outside webroot.

ALLOWED_ORIGINS=https://framespark.cn
TRUST_PROXY=loopback

# Deployment-contract documentation. The current application uses this fixed
# header name; it does not read this value dynamically from env.
BETA_IDENTITY_HEADER=X-Framespark-Beta-User

# Access foundation. Enable either invite-code verification or public beta
# anonymous sessions only after the matching Nginx/static production rollout is
# ready and reviewed.
BETA_ACCESS_DB_PATH=/var/lib/framespark-diagnosis/access/beta-access.sqlite
# BETA_ACCESS_CODE_HMAC_KEY is a distinct random secret of at least 32 bytes.
# BETA_ACCESS_SESSION_HMAC_KEY is another distinct random secret of at least 32 bytes.
BETA_ACCESS_SESSION_TTL_HOURS=24
BETA_ACCESS_DEFAULT_EXPIRES_DAYS=7
BETA_ACCESS_DEFAULT_MAX_USES=5
BETA_ACCESS_CODE_MAX_CHARS=256
BETA_ACCESS_COOKIE_SECURE=true
BETA_ACCESS_ORIGINAL_URI_HEADER=x-framespark-original-uri
BETA_ACCESS_AUDIT_RETENTION_DAYS=30
BETA_ACCESS_VERIFY_WINDOW_MINUTES=15
BETA_ACCESS_VERIFY_IP_WINDOW_LIMIT=5
BETA_ACCESS_VERIFY_IP_DAILY_LIMIT=20
BETA_ACCESS_VERIFY_GLOBAL_WINDOW_LIMIT=30
BETA_ACCESS_VERIFY_GLOBAL_DAILY_LIMIT=100
BETA_ACCESS_VERIFY_COOLDOWN_SECONDS=2

# Deployment-contract documentation. Current logging code is designed to be
# metadata-only; it does not read this value dynamically from env.
LOG_REDACTION_REQUIRED=true
