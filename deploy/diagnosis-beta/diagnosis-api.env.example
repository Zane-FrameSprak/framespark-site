# DRAFT PRODUCTION ENV TEMPLATE ONLY.
# Copy values through an approved secure process. Never commit the real env file.
# DEEPSEEK_API_KEY must remain a placeholder in this repository.

NODE_ENV=production
HOST=127.0.0.1
PORT=8788

DEEPSEEK_API_KEY=REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=90000
REQUEST_TIMEOUT_MS=210000

ENABLE_DIAGNOSIS_V1=true
ENABLE_V1_STAGED_RUNNER=true
ENABLE_V1_REAL_PROMPTS=true
ENABLE_DEV_TOOLS=false
FAIL_CLOSED_ON_V1_ERROR=true
REQUIRE_BETA_IDENTITY=true

MAX_UPLOAD_MB=5
MAX_DOCX_EXPANDED_MB=20
MIN_TEXT_CHARS=80
MAX_TEXT_CHARS=20000

PROVIDER_CALL_LIMIT_PER_DIAGNOSIS=5
DIAGNOSIS_ACCOUNT_DAILY_LIMIT=3
DIAGNOSIS_IP_DAILY_LIMIT=6
DIAGNOSIS_GLOBAL_DAILY_LIMIT=20
PROVIDER_GLOBAL_DAILY_LIMIT=100
DIAGNOSIS_CONCURRENCY_LIMIT=2
DIAGNOSIS_FEEDBACK_DAILY_LIMIT=10

DIAGNOSIS_DATA_DIR=/var/lib/framespark-diagnosis
DIAGNOSIS_METADATA_RETENTION_DAYS=30
DIAGNOSIS_REVIEW_RETENTION_DAYS=14

ALLOWED_ORIGINS=https://framespark.cn
TRUST_PROXY=loopback

# Deployment-contract documentation. The current application uses this fixed
# header name; it does not read this value dynamically from env.
BETA_IDENTITY_HEADER=X-Framespark-Beta-User

# Deployment-contract documentation. Current logging code is designed to be
# metadata-only; it does not read this value dynamically from env.
LOG_REDACTION_REQUIRED=true
